    },
    "KeepFilesConfirmMessage %@" : {
      "comment" : "Confirmation message; %@ is the new retention period",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With “%@”, local captures older than this period are deleted now. This cannot be undone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З параметром «%@» локальні знімки, старіші за цей період, буде видалено зараз. Цю дію не можна скасувати."
          }
        }
      }
    },
