    },
    "KeepFilesFootnote" : {
      "comment" : "Footnote under the retention picker",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes photos, videos and “Save snapshot to disk” copies on this Mac. Copies in iCloud, Dropbox and sent mail, and the images in the history, are kept. “None” deletes files only after iCloud or Dropbox confirms the upload; otherwise it keeps them for 1 week."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє фото, відео та копії «Зберегти знімок на диск» на цьому Mac. Копії в iCloud, Dropbox і надісланих листах, а також зображення в історії залишаються. «Не зберігати» видаляє файли лише після того, як iCloud або Dropbox підтвердить вивантаження; інакше файли зберігаються 1 тиждень."
          }
        }
      }
    },
    "KeepFilesConfirmTitle" : {
      "comment" : "Title of the confirmation shown when the retention period is shortened",
