    "RetentionNoticeBody %@ %@" : {
      "comment" : "One-time notice; %1$@ is the retention period, %2$@ the first deletion date",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Keep files” is set to %1$@. Captures saved before this update will be deleted from this Mac starting %2$@. To change this, open Settings > Options > Keep files."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр «Зберігати файли» має значення «%1$@». Знімки, збережені до цього оновлення, буде видалено з цього Mac, починаючи з %2$@. Щоб змінити це, відкрийте Налаштування > Параметри > Зберігати файли."
          }
        }
      }
    },
